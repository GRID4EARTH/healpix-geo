{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "lib": ["es2021", "esnext.disposable", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": "."
  },
  "include": ["tests/*.ts"]
}
